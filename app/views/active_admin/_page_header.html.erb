<div id="page-header" data-test-page-header class="bg-gray-50 border-b border-gray-200 p-4 mb-8 flex flex-col gap-4 md:flex-row md:items-center justify-between dark:border-gray-800/50 dark:bg-inherit">
  <%= render "active_admin/page_heading", title: title %>
  <% if action_items_for_action.present? %>
    <div id="action-items" data-test-action-items class="flex gap-2 flex-wrap lg:justify-end">
      <%= render "active_admin/shared/action_items" %>
    </div>
  <% end %>
</div>
